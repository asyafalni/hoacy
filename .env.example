# ─────────────────────────────────────────────────────────────────────────────
# .env FRONTEND (Vue) — salin:  cp .env.example .env   lalu cek: npm run cek-env
# Semua nilai VITE_* ikut ke JavaScript yang diunduh setiap pengunjung, jadi
# HANYA nilai publik di sini. Rahasia (database, Clerk secret key, Google) ada
# di backend/.env (lokal) dan env var terenkripsi DigitalOcean — lihat
# backend/.env.example.
# ─────────────────────────────────────────────────────────────────────────────

# Clerk → Configure → API keys → Publishable key (pk_test_… untuk dev instance).
# Kosongkan saat `npm run dev` untuk masuk Kas tanpa Clerk (backend APP_ENV=development).
VITE_CLERK_PUBLISHABLE_KEY=

# Nomor WhatsApp operasional pengurus — tombol "Hubungi pengurus". Berawalan 62.
VITE_WA_OPERASIONAL=

# Sub-path situs. Kosong untuk DigitalOcean (situs di root domain).
VITE_BASE=
