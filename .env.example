# ─────────────────────────────────────────────────────────────────────────────
# .env untuk build & deploy. Salin dulu:   cp .env.example .env
# lalu isi setiap nilai, dan cek:          node scripts/cek-env.mjs
# Deploy (Docker/Fly) menolak build kalau ada yang kosong — tanpa VITE_API_URL
# situs jalan dengan data mock, tanpa id Form semua pencatatan hilang.
#
# Semua nilai di sini PUBLIK (ikut terbaca di JavaScript situs). Jangan taruh
# PIN di sini — PIN Pos/Kas ada di Script Properties Apps Script (Tahap 6).
#
# Cara mengambil nilai Form (docs/setup.md Tahap 7):
#  • ID Form  → Form → Send → ikon link 🔗 → URL
#    https://docs.google.com/forms/d/e/<ID INI>/viewform
#    (BUKAN ID dari URL editor /forms/d/…/edit)
#  • Entry id → editor Form → ⋮ → Get pre-filled link → isi tiap pertanyaan
#    berurutan dengan A, B, C, D → Get link → Copy link. Di URL-nya:
#    entry.111=A&entry.222=B… → pertanyaan ke-1 = entry.111, dst.
#    Tulis lengkap dengan awalan "entry.", contoh: entry.1234567890
# ─────────────────────────────────────────────────────────────────────────────

# Web App Apps Script (Tahap 6) — https://script.google.com/macros/s/…/exec
# Dikosongkan hanya untuk `npm run dev` dengan data mock (PIN pos 1234, kas 5678).
VITE_API_URL=

# Form A "Catat Tunai" → tab L-Tunai
VITE_FORM_TUNAI=
VITE_E_TUNAI_ALAMAT=          # pertanyaan 1 · Alamat
VITE_E_TUNAI_RINCIAN=         # pertanyaan 2 · Rincian
VITE_E_TUNAI_TOTAL=           # pertanyaan 3 · Total
VITE_E_TUNAI_PETUGAS=         # pertanyaan 4 · Petugas

# Form B "Konfirmasi Transfer" → tab L-Transfer
# (pertanyaan 4, upload bukti, tidak punya entry id — dilewati)
VITE_FORM_TRANSFER=
VITE_E_TRANSFER_ALAMAT=       # pertanyaan 1 · Alamat
VITE_E_TRANSFER_RINCIAN=      # pertanyaan 2 · Rincian
VITE_E_TRANSFER_TOTAL=        # pertanyaan 3 · Total

# Form C "Setor ke Bank" → tab L-Setoran
VITE_FORM_SETORAN=
VITE_E_SETOR_NOMINAL=         # pertanyaan 1 · Nominal
VITE_E_SETOR_OLEH=            # pertanyaan 2 · Oleh

# Form E "Keputusan" → tab L-Keputusan
VITE_FORM_KEPUTUSAN=
VITE_E_KEP_ALAMAT=            # pertanyaan 1 · Alamat
VITE_E_KEP_WAKTU=             # pertanyaan 2 · Waktu kiriman
VITE_E_KEP_KEPUTUSAN=         # pertanyaan 3 · Keputusan (sah / tolak)
VITE_E_KEP_OLEH=              # pertanyaan 4 · Oleh

# (Form D "Pengeluaran" tidak ada di sini — tidak ada layar app yang memakainya.)

# Nomor WhatsApp operasional pengurus — tujuan tombol "Ada kendala? Hubungi
# pengurus" di dialog konfirmasi transfer dan di layar Pos. Berawalan 62, tanpa + / spasi.
VITE_WA_OPERASIONAL=

# Sub-path situs. Kosongkan untuk Fly.io (situs di root domain).
VITE_BASE=
