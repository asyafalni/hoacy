# Sheet published to web (docs/sheets-schema.md)
VITE_SHEET_ID=

# Entry ids are generated by Google per Form — copy the real ones
# (docs/form-mapping.md). Left blank on purpose: a wrong id silently drops
# that answer from every submission.

# Form A "Catat Tunai" (docs/form-mapping.md)
VITE_FORM_TUNAI=
VITE_E_TUNAI_ALAMAT=
VITE_E_TUNAI_RINCIAN=
VITE_E_TUNAI_TOTAL=
VITE_E_TUNAI_PETUGAS=

# Form B "Konfirmasi Transfer"
VITE_FORM_TRANSFER=
VITE_E_TRANSFER_ALAMAT=
VITE_E_TRANSFER_RINCIAN=
VITE_E_TRANSFER_TOTAL=

# Form C "Setor ke Bank"
VITE_FORM_SETORAN=
VITE_E_SETOR_NOMINAL=
VITE_E_SETOR_OLEH=

# Form E "Keputusan"
VITE_FORM_KEPUTUSAN=
VITE_E_KEP_ALAMAT=
VITE_E_KEP_WAKTU=
VITE_E_KEP_KEPUTUSAN=
VITE_E_KEP_OLEH=

# GitHub Pages base path, e.g. /hoacy/ — see docs/deploy.md
VITE_BASE=

# Deterrent-only PIN for /pos and /kas — NOT a real secret, it ships inside the
# public JS bundle like everything else here. It just keeps warga from wandering
# into the petugas screens; share these numbers directly with satpam/bendahara/
# admin/komite. Leave blank to keep a screen permanently locked.
VITE_PIN_POS=
VITE_PIN_KAS=
