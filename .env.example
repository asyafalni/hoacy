# Apps Script web app URL — the app's only door to the (private) Sheet; PINs live
# there as Script Properties, never in this file (docs/setup.md, Tahap 6).
# Leave blank for `npm run dev` on built-in mock data (PIN pos 1234, kas 5678).
VITE_API_URL=

# Entry ids are generated by Google per Form — copy the real ones
# (docs/form-mapping.md). Left blank on purpose: a wrong id silently drops
# that answer from every submission.

# Form A "Catat Tunai" (docs/form-mapping.md)
VITE_FORM_TUNAI=
VITE_E_TUNAI_ALAMAT=
VITE_E_TUNAI_RINCIAN=
VITE_E_TUNAI_TOTAL=
VITE_E_TUNAI_PETUGAS=

# Form B "Konfirmasi Transfer"
VITE_FORM_TRANSFER=
VITE_E_TRANSFER_ALAMAT=
VITE_E_TRANSFER_RINCIAN=
VITE_E_TRANSFER_TOTAL=

# Form C "Setor ke Bank"
VITE_FORM_SETORAN=
VITE_E_SETOR_NOMINAL=
VITE_E_SETOR_OLEH=

# Form E "Keputusan"
VITE_FORM_KEPUTUSAN=
VITE_E_KEP_ALAMAT=
VITE_E_KEP_WAKTU=
VITE_E_KEP_KEPUTUSAN=
VITE_E_KEP_OLEH=

# GitHub Pages base path, e.g. /hoacy/ — see docs/deploy.md
VITE_BASE=
