# Vue Vapor ships only as a 3.6 release candidate (vue@^3.6.0-rc), and npm treats
# a prerelease as outside @vitejs/plugin-vue's `vue@^3.2.25` peer range, so a
# strict `npm ci` refuses the lockfile. The plugin works with it; keep installs
# reproducible everywhere (local, Docker, Fly) instead of per-machine flags.
legacy-peer-deps=true
