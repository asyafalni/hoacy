# ─────────────────────────────────────────────────────────────────────────────
# backend/.env — RAHASIA, lokal saja (sudah di .gitignore). Salin:
#   cp backend/.env.example backend/.env
# Di DigitalOcean nilai yang sama diisi sebagai env var terenkripsi
# (.do/app.yaml, docs/deploy.md). Jangan pernah tempel nilai ini di chat/issue.
# ─────────────────────────────────────────────────────────────────────────────

# development = tanpa Clerk & Google (pengurus masuk dengan email, bukti disimpan
# di folder lokal). Produksi menolak start kalau rahasia di bawah tidak lengkap.
APP_ENV=development
PORT=8080

# Aiven → service → Overview → Service URI (postgres://…?sslmode=require).
# Untuk pengembangan pakai Postgres lokal (docs/setup.md):
DATABASE_URL=postgres://postgres:dev@127.0.0.1:55432/hoacy?sslmode=disable

# Minimal 32 karakter acak — menandatangani sesi warga. Buat dengan:
#   openssl rand -base64 48
SESSION_SECRET=

# Clerk → Configure → API keys → Secret key (sk_test_… / sk_live_…).
CLERK_SECRET_KEY=

# Admin pertama (dibuat sekali kalau belum ada admin). Lainnya ditambah di app.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_NAMA=Admin

# Akun Google khusus RT (docs/setup.md): OAuth client "Desktop app", lalu
#   go run ./cmd/google-login   → mencetak GOOGLE_REFRESH_TOKEN
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# Folder Drive untuk bukti & nota (ID dari URL drive.google.com/drive/folders/<ID>)
DRIVE_FOLDER_ID=
# Spreadsheet sumber sinkron (ID dari URL docs.google.com/spreadsheets/d/<ID>/edit)
SHEET_ID=

# ── hanya pengembangan ──
# Folder bukti lokal (tanpa Google) dan sumber sinkron CSV (tanpa Google):
BERKAS_DIR=berkas-lokal
SHEET_CSV_DIR=dev/sheet
# Patok "hari ini" — data dev dibuat di sekitar 2026-09-22:
HARI_TETAP=2026-09-22
# Header IP di belakang proxy (DigitalOcean: do-connecting-ip). Kosong = alamat TCP.
IP_HEADER=
